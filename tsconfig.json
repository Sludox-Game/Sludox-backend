{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["src/*"],
      "@auth/*": ["src/auth/*"],
      "@match/*": ["src/match/*"],
      "@voice/*": ["src/voice/*"],
      "@blockchain/*": ["src/blockchain/*"],
      "@common/*": ["src/common/*"]
    }
  },
  "include": ["src/**/*"]
}
