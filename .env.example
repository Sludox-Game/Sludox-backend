# ──────────────────────────────────────────────
# Sludox Backend Environment Configuration
# ──────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=sludox
DATABASE_PASSWORD=sludox_dev
DATABASE_NAME=sludox

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Deploy a contract and set its ID here.
# ⚠️ Known issue: Soroban testnet (Protocol 26) creates contracts with SUCCESS
#    status but does NOT persist the contract instance on the ledger.
#    WASM upload works fine. Test with "node contracts/deploy.js"
# When the testnet is stable, deploy with:
#   cd contracts && node deploy.js --network testnet
CONTRACT_ID=

# Session Keys
SESSION_KEY_EXPIRY_MINUTES=60

# Game Config
TURN_TIMEOUT_SECONDS=15
MAX_TIMEOUT_STRIKES=2
BASE_BUY_IN_XLM=0.2
CAPTURE_REWARD_XLM=0.05
PLATFORM_RAKE_PERCENT=5

# BullMQ
BULLMQ_QUEUE_NAME=transaction-queue
